{
  "name": "ship-ai-sandbox",
  "private": true,
  "description": "AI Application Engineer learning sandbox — npm scripts as a launcher",
  "scripts": {
    "hub": ".venv/bin/python app.py",
    "01": ".venv/bin/python 01-note-sorter/app.py",
    "02": ".venv/bin/python 02-tool-use/app.py",
    "03": ".venv/bin/python 03-ollama/app.py",
    "04": ".venv/bin/python 04-gym-plan/app.py",
    "05": ".venv/bin/python 05-rag/app.py",
    "06": ".venv/bin/python 06-gguf/app.py",
    "07": ".venv/bin/uvicorn --app-dir 07-fastapi server:app --port 8600 --reload",
    "07:ui": ".venv/bin/python 07-fastapi/app.py",
    "08": ".venv/bin/uvicorn --app-dir 08-asyncio server:app --port 8601 --reload",
    "08:ui": ".venv/bin/python 08-asyncio/app.py",
    "check:01": ".venv/bin/python 01-note-sorter/categorize.py",
    "check:02": ".venv/bin/python 02-tool-use/agent.py",
    "check:03": ".venv/bin/python 03-ollama/check.py",
    "check:04": ".venv/bin/python 04-gym-plan/check.py",
    "check:05": ".venv/bin/python 05-rag/check.py retrieve",
    "check:05:build": ".venv/bin/python 05-rag/check.py build",
    "check:06": ".venv/bin/python 06-gguf/check.py",
    "check:07": ".venv/bin/python 07-fastapi/check.py",
    "check:08": ".venv/bin/python 08-asyncio/check.py",
    "ollama:start": "./scripts/start-ollama.sh",
    "ollama:stop": "./scripts/stop-ollama.sh",
    "provider:gigachat": ".venv/bin/python scripts/set_provider.py gigachat",
    "provider:ollama": ".venv/bin/python scripts/set_provider.py ollama",
    "install:py": ".venv/bin/python -m pip install -r requirements.txt"
  }
}
