# GigaChat Freemium: Authorization key from Studio (Base64 ClientID:Secret)
# Get it: https://developers.sber.ru/studio → проект GigaChat API → Получить ключ
LLM_API_KEY=paste-authorization-key-here
LLM_BASE_URL=https://api.giga.chat/v1
LLM_MODEL=GigaChat-2
LLM_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
LLM_SCOPE=GIGACHAT_API_PERS
LLM_SSL_VERIFY=false
